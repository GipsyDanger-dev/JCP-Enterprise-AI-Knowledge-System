[TEMPLATE]
# Base URL backend API (tanpa trailing slash)
VITE_API_BASE_URL=http://localhost:8080/api

# Mock auth & mock backend aktif secara default di development.
# Set false saat backend sudah siap: VITE_USE_MOCK_AUTH=false
# Di produksi, mock hanya aktif bila VITE_USE_MOCK_AUTH=true dieksplisitkan.
