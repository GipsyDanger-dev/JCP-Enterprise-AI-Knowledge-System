# Backend API base URL (tanpa trailing slash dan tanpa prefix /api)
VITE_API_BASE_URL=http://localhost:8000

# Kredensial E2E lokal. Isi dengan akun yang benar-benar dibuat oleh seed Backend.
# Jangan commit nilai aslinya. Variabel tanpa prefix VITE_ tidak dikirim ke browser.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Opsional: diperlukan hanya untuk pemeriksaan akses role USER.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Opsional: bila kosong, suite chat hanya memeriksa halaman tanpa mengirim query.
E2E_CHAT_QUESTION=

# Opsional: pertanyaan kedua untuk memverifikasi conversationId tetap sama.
E2E_CHAT_FOLLOWUP=

# Opsional bila URL Frontend atau lokasi Chrome berbeda.
# E2E_BASE_URL=http://127.0.0.1:5173
# CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
