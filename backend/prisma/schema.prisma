generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tingkat wewenang, bukan bidang kerja. Bidang kerja pindah ke UnitKerja:
// dua orang di dinas yang sama butuh dokumen yang sama, yang membedakan
// hanya seberapa jauh mereka boleh mengubah isinya.
enum UserRole {
  // Legacy — masih ada di database, tidak dipakai lagi oleh kode.
  ADMIN
  USER
  BENDAHARA
  SEKRETARIS
  OPERASIONAL
  HUMAS
  // Dipakai sekarang
  SUPER_ADMIN
  /// Boleh mengelola dokumen milik unit kerjanya sendiri, tidak unit lain.
  ADMIN_UNIT
  PEGAWAI
}

// Jenis produk hukum — mengikuti kategori resmi JDIH Sleman satu lawan satu.
enum DocumentType {
  PERATURAN_DAERAH
  PERATURAN_BUPATI
  KEPUTUSAN_BUPATI
  INSTRUKSI_BUPATI
  RANCANGAN_PUU
  PERATURAN_DESA
  PUTUSAN_PENGADILAN
}

// Status keberlakuan. Dipakai untuk mencegah AI menjawab dengan rancangan
// atau aturan yang sudah dicabut — kesalahan yang tidak terlihat dari isi teks.
enum LegalStatus {
  BERLAKU
  RANCANGAN
  DIUBAH
  DICABUT
}

enum DocumentStatus {
  UPLOADED
  QUEUED
  PROCESSING
  READY
  FAILED
  DELETED
}

enum ProcessingJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum AuditActorType {
  USER
  WORKER
  SYSTEM
}

enum AuditAction {
  AUTH_LOGIN
  AUTH_LOGOUT
  USER_CREATED
  USER_UPDATED
  DOCUMENT_UPLOADED
  DOCUMENT_DELETED
  PROCESSING_JOB_CLAIMED
  PROCESSING_JOB_COMPLETED
  PROCESSING_JOB_FAILED
}

enum NotificationType {
  REQUIRED_READING_ASSIGNED
  REQUIRED_READING_COMPLETED
  ANNOUNCEMENT_PUBLISHED
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String?              @unique
  username            String?              @unique
  employeeNumber      String               @unique @map("employee_number")
  // Teks bebas warisan; dipertahankan supaya data lama tidak hilang.
  // Sumber kebenaran untuk hak akses adalah unitKerjaId.
  division            String
  jobTitle            String               @map("job_title")
  unitKerjaId         String?              @map("unit_kerja_id") @db.Uuid
  unitKerja           UnitKerja?           @relation(fields: [unitKerjaId], references: [id], onDelete: SetNull)
  passwordHash        String               @map("password_hash")
  displayName         String               @map("display_name")
  role                UserRole             @default(SUPER_ADMIN)
  isAdmin             Boolean              @default(false) @map("is_admin")
  isActive            Boolean              @default(true) @map("is_active")
  photoUrl            String?              @map("photo_url")
  lastLoginAt         DateTime?            @map("last_login_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  documents           Document[]
  conversations       Conversation[]
  directConversations DirectConversation[]
  auditLogs           AuditLog[]
  sessions            Session[]
  requiredReadings    RequiredReading[]
  notifications       AppNotification[]
  announcements       Announcement[]

  @@map("users")
}

model Document {
  id               String            @id @default(uuid()) @db.Uuid
  title            String
  // Dipertahankan sementara supaya frontend lama tidak pecah; digantikan oleh
  // categoryId dan akan dihapus setelah semua pemakainya pindah.
  collection       String?           @default("Umum")
  status           DocumentStatus    @default(UPLOADED)
  // Sumbu 1 — jenis produk hukum. Bisa diisi otomatis dari folder asal.
  documentType     DocumentType?     @map("document_type")
  // Sumbu 2 — subjek/bidang. Inilah yang menentukan siapa boleh melihat.
  categoryId       String?           @map("category_id") @db.Uuid
  category         DocumentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Pembatas tambahan di atas kategori: bila diisi, hanya unit kerja ini
  /// (dan admin) yang boleh melihat dokumennya. Sengaja hanya bisa
  /// MEMPERSEMPIT — penanda yang bisa memperluas akan membocorkan dokumen ke
  /// luar kategorinya tanpa ada yang menyadari.
  unitKerjaId      String?           @map("unit_kerja_id") @db.Uuid
  unitKerja        UnitKerja?        @relation(fields: [unitKerjaId], references: [id], onDelete: SetNull)
  // Sumbu 3 — status keberlakuan.
  legalStatus      LegalStatus       @default(BERLAKU) @map("legal_status")
  // Nomor dan tahun peraturan, untuk pencarian "Perbup No 11 Tahun 2026".
  // Pencarian vektor buruk untuk pertanyaan bernomor, jadi ini dicari lewat kolom.
  regulationNumber String?           @map("regulation_number")
  regulationYear   Int?              @map("regulation_year")
  uploadedById     String            @map("uploaded_by_id") @db.Uuid
  uploadedBy       User              @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  versions         DocumentVersion[]
  deletedAt        DateTime?         @map("deleted_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  requiredReadings RequiredReading[]

  @@index([status])
  @@index([uploadedById])
  @@index([categoryId, legalStatus])
  @@index([unitKerjaId])
  @@index([regulationYear, regulationNumber])
  @@map("documents")
}

/// Unit kerja / OPD. Berupa tabel, bukan enum, karena daftarnya berubah setiap
/// ada reorganisasi perangkat daerah — mengubah baris jauh lebih murah daripada
/// mengubah tipe enum PostgreSQL. Isi awalnya versi sementara sampai daftar
/// resmi dari Perbup SOTK didapat; menggantinya cukup lewat seed.
model UnitKerja {
  id         String             @id @default(uuid()) @db.Uuid
  name       String
  code       String             @unique
  isActive   Boolean            @default(true) @map("is_active")
  createdAt  DateTime           @default(now()) @map("created_at")
  users      User[]
  documents  Document[]
  categories DocumentCategory[] @relation("CategoryAccess")

  @@index([name])
  @@map("unit_kerja")
}

model DocumentCategory {
  id        String      @id @default(uuid()) @db.Uuid
  name      String
  key       String      @unique
  // Daftar kosong berarti terbuka untuk semua pegawai yang sudah login.
  // Hak akses sengaja ditempel di kategori: menandai ratusan dokumen satu per
  // satu terlalu rawan salah, sedangkan kategori cukup ditandai sekali.
  units     UnitKerja[] @relation("CategoryAccess")
  documents Document[]
  createdAt DateTime    @default(now()) @map("created_at")

  @@index([name])
  @@map("document_categories")
}

model RequiredReading {
  id             String    @id @default(uuid()) @db.Uuid
  documentId     String    @map("document_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  progress       Int       @default(0)
  assignedAt     DateTime  @default(now()) @map("assigned_at")
  dueAt          DateTime  @map("due_at")
  lastProgressAt DateTime? @map("last_progress_at")
  completedAt    DateTime? @map("completed_at")
  document       Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@index([userId, completedAt])
  @@index([documentId, completedAt])
  @@map("required_readings")
}

model AppNotification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String?
  href      String?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("app_notifications")
}

model Announcement {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(180)
  body        String   @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  publishedAt DateTime @default(now()) @map("published_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String   @map("created_by_id") @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([isActive, publishedAt])
  @@index([createdById])
  @@map("announcements")
}

model DocumentVersion {
  id               String          @id @default(uuid()) @db.Uuid
  documentId       String          @map("document_id") @db.Uuid
  document         Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber    Int             @map("version_number")
  originalFilename String          @map("original_filename")
  mimeType         String          @map("mime_type")
  storageKey       String?         @unique @map("storage_key")
  fileSize         Int             @map("file_size")
  checksum         String?
  pageCount        Int?            @map("page_count")
  createdAt        DateTime        @default(now()) @map("created_at")
  file             DocumentFile?
  processingJobs   ProcessingJob[]
  citations        Citation[]
  chunks           DocumentChunk[]

  @@unique([documentId, versionNumber])
  @@index([documentId])
  @@map("document_versions")
}

model DocumentFile {
  id                String          @id @default(uuid()) @db.Uuid
  documentVersionId String          @unique @map("document_version_id") @db.Uuid
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  content           Bytes           @db.ByteA
  createdAt         DateTime        @default(now()) @map("created_at")

  @@map("document_files")
}

model DocumentChunk {
  chunkId           String                       @id @map("chunk_id")
  documentVersionId String                       @map("document_version_id") @db.Uuid
  documentVersion   DocumentVersion              @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  pageNumber        Int?                         @map("page_number")
  sectionTitle      String                       @default("") @map("section_title")
  text              String                       @db.Text
  embedding         Unsupported("vector(1536)")?
  createdAt         DateTime                     @default(now()) @map("created_at")

  @@index([documentVersionId])
  @@map("chunks")
}

model ProcessingJob {
  id                String              @id @default(uuid()) @db.Uuid
  documentVersionId String              @map("document_version_id") @db.Uuid
  documentVersion   DocumentVersion     @relation(fields: [documentVersionId], references: [id], onDelete: Cascade)
  idempotencyKey    String              @unique @map("idempotency_key")
  status            ProcessingJobStatus @default(QUEUED)
  attemptCount      Int                 @default(0) @map("attempt_count")
  errorMessage      String?             @map("error_message") @db.Text
  startedAt         DateTime?           @map("started_at")
  completedAt       DateTime?           @map("completed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([documentVersionId])
  @@index([status, createdAt])
  @@map("processing_jobs")
}

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  title     String?
  messages  Message[]
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@index([userId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String       @db.Text
  citations      Citation[]
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Citation {
  id                String          @id @default(uuid()) @db.Uuid
  messageId         String          @map("message_id") @db.Uuid
  message           Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  documentVersionId String          @map("document_version_id") @db.Uuid
  documentVersion   DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  chunkId           String          @map("chunk_id")
  pageNumber        Int?            @map("page_number")
  sectionTitle      String?         @map("section_title")
  excerpt           String?         @db.Text
  sortOrder         Int             @default(0) @map("sort_order")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@unique([messageId, chunkId])
  @@index([messageId, sortOrder])
  @@index([documentVersionId])
  @@map("citations")
}

model AuditLog {
  id          String         @id @default(uuid()) @db.Uuid
  actorType   AuditActorType @map("actor_type")
  actorUserId String?        @map("actor_user_id") @db.Uuid
  actorUser   User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      AuditAction
  targetType  String         @map("target_type")
  targetId    String?        @map("target_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model DirectConversation {
  id            String          @id @default(uuid()) @db.Uuid
  employeeId    String          @map("employee_id") @db.Uuid
  employee      User            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  lastMessage   String?         @map("last_message") @db.Text
  lastMessageAt DateTime?       @map("last_message_at")
  unreadCount   Int             @default(0) @map("unread_count")
  messages      DirectMessage[]
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@unique([employeeId])
  @@index([updatedAt])
  @@map("direct_conversations")
}

model DirectMessage {
  id             String             @id @default(uuid()) @db.Uuid
  conversationId String             @map("conversation_id") @db.Uuid
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String             @db.VarChar(20)
  senderName     String?            @map("sender_name") @db.VarChar(100)
  content        String             @db.Text
  attachments    Json?
  editedAt       DateTime?          @map("edited_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("direct_messages")
}

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique @map("token_hash")
  userAgent    String?   @map("user_agent")
  ipAddress    String?   @map("ip_address")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastActiveAt DateTime  @default(now()) @map("last_active_at")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
