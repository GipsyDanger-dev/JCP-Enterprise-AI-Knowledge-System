# ==== Database (dipakai bersama oleh backend, ai-api, dan ai-worker) ====
# VPS/production: ganti semua nilai CHANGE_ME. Password pada DATABASE_URL harus
# sama dengan POSTGRES_PASSWORD (gunakan URL encoding bila ada karakter khusus).
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=rag_knowledge
DATABASE_URL=postgresql://rag_user:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/rag_knowledge

# ==== Backend (NestJS) ====
# Host bindings default ke loopback. Ubah port bila bentrok dengan service VPS.
BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
BACKEND_PORT=8000
AI_API_PORT=8001
FRONTEND_PORT=5173
JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=1h
AI_SERVICE_URL=http://ai-api:8000
AI_SERVICE_TIMEOUT_MS=60000
WORKER_TOKEN=CHANGE_ME_SEPARATE_LONG_RANDOM_WORKER_TOKEN

# Local development seed only. Biarkan kosong dan jangan jalankan seed di VPS.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# ==== AI Service (Python/FastAPI) ====
SUMOPOD_API_KEY=CHANGE_ME_SUMOPOD_API_KEY
WORKER_POLL_SECONDS=5

# ==== Frontend (React/Vite) ====
# PENTING: sebelumnya default frontend menunjuk ke :8080/api — sudah diperbaiki
# di sini supaya cocok dengan backend yang jalan tanpa prefix /api di :8000.
# VPS: ganti dengan URL HTTPS publik Backend, bukan localhost.
VITE_API_BASE_URL=http://localhost:8000
