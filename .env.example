# ==== Database (PostgreSQL + pgvector) ====
# Local development memakai service `postgres` dari docker-compose.yml.
# Production memakai docker-compose.prod.yml dan database eksternal (misalnya
# Neon). Isi DATABASE_URL dan AI_DATABASE_URL untuk deployment production.
POSTGRES_USER=jcp
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=jcp_enterprise_ai
POSTGRES_PORT=5432
# Dipakai bila Backend/AI dijalankan native dari Windows (host memakai
# 127.0.0.1, antar-container memakai hostname `postgres`).
DATABASE_URL=postgresql://jcp:change-this-postgres-password@127.0.0.1:5432/jcp_enterprise_ai?schema=public
AI_DATABASE_URL=postgresql://jcp:change-this-postgres-password@127.0.0.1:5432/jcp_enterprise_ai

# ==== Backend (NestJS) ====
BACKEND_PORT=8000
JWT_SECRET=your-random-secret-min-32-chars
JWT_EXPIRES_IN=24h
AI_SERVICE_URL=http://127.0.0.1:8001
# Shared secret Backend <-> AI Service. Dipakai dua arah: guard endpoint
# /internal/* di Backend, dan header X-Worker-Token saat Backend memanggil
# AI Service. Harus berbeda dari JWT_SECRET dan tidak pernah dikirim ke frontend.
WORKER_TOKEN=your-worker-token-here
# Durasi akses trial untuk workspace perusahaan yang mendaftar sendiri.
TRIAL_DURATION_DAYS=7

# SumoPod payment sandbox (server-only)
PAYMENT_PROVIDER=sumopod
SUMOPOD_MODE=sandbox
SUMOPOD_PAYMENT_BASE_URL=https://api-pay-sandbox.sumopod.com/api/v1
SUMOPOD_PAYMENT_API_KEY=
SUMOPOD_WEBHOOK_SECRET=
SUMOPOD_WEBHOOK_TOKEN=
PAYMENT_SUCCESS_RETURN_URL=http://127.0.0.1:5173/billing/return
PAYMENT_CANCEL_RETURN_URL=http://127.0.0.1:5173/billing/return

# Seed accounts (min 12 chars password)
SEED_ADMIN_EMAIL=admin@jcp.co.id
SEED_ADMIN_PASSWORD=admin1234567
SEED_USER_EMAIL=nadia@jcp.co.id
SEED_USER_PASSWORD=employee12345

# ==== AI Engine (provider OpenAI-compatible) ====
AI_PROVIDER_API_KEY=replace-with-provider-api-key
# Base URL harus berakhir pada /v1, tanpa /chat/completions.
AI_PROVIDER_BASE_URL=https://provider.example/v1
AI_CHAT_MODEL=auto
# Aktifkan hanya bila provider menyediakan endpoint /v1/embeddings.
AI_EMBEDDINGS_ENABLED=false
# Hanya dipakai apabila embeddings diaktifkan.
AI_EMBEDDING_MODEL=text-embedding-3-small

# ==== Frontend (React/Vite) ====
VITE_API_BASE_URL=http://127.0.0.1:8000
# Dipakai vite.config.ts sebagai port dev server.
FRONTEND_PORT=5173
# VPS: ganti dengan URL HTTPS publik Backend. Nilai ini dibaca saat image
# production dibangun, jadi rebuild frontend setelah mengubahnya.

# ==== Personal login with Google ====
# Public OAuth Web Client ID. Use the same value for Backend token audience
# validation and Frontend Google Identity Services initialization.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
