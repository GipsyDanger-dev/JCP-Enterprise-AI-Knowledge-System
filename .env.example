# ==== Database (PostgreSQL + pgvector — Neon atau PostgreSQL milik sendiri) ====
# Compose tidak menjalankan service postgres; DATABASE_URL wajib diisi.
# Dipakai bila Backend/AI dijalankan native dari Windows. Docker Compose
# memakai nilai yang sama; AI service memakai AI_DATABASE_URL tanpa
# query parameter `schema=public` yang tidak dikenal psycopg/libpq.
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public
AI_DATABASE_URL=postgresql://user:password@host:5432/dbname

# ==== Backend (NestJS) ====
BACKEND_PORT=8000
JWT_SECRET=your-random-secret-min-32-chars
JWT_EXPIRES_IN=24h
AI_SERVICE_URL=http://127.0.0.1:8001
# Shared secret Backend <-> AI Service. Dipakai dua arah: guard endpoint
# /internal/* di Backend, dan header X-Worker-Token saat Backend memanggil
# AI Service. Harus berbeda dari JWT_SECRET dan tidak pernah dikirim ke frontend.
WORKER_TOKEN=your-worker-token-here

# Seed accounts (min 12 chars password)
SEED_ADMIN_EMAIL=admin@jcp.co.id
SEED_ADMIN_PASSWORD=admin1234567
SEED_USER_EMAIL=nadia@jcp.co.id
SEED_USER_PASSWORD=employee12345

# ==== AI Engine (Python/FastAPI) ====
SUMOPOD_API_KEY=sk-your-sumopod-api-key-here
# Dibaca AI/config.py dan diteruskan ke container ai-api lewat docker-compose.
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
AI_CHAT_MODEL=deepseek-v4-pro

# ==== Frontend (React/Vite) ====
VITE_API_BASE_URL=http://127.0.0.1:8000
# Dipakai vite.config.ts sebagai port dev server.
FRONTEND_PORT=5173
# VPS: ganti dengan URL HTTPS publik Backend. Nilai ini dibaca saat image
# production dibangun, jadi rebuild frontend setelah mengubahnya.

# ==== Personal login with Google ====
# Public OAuth Web Client ID. Use the same value for Backend token audience
# validation and Frontend Google Identity Services initialization.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
