# ==== Database (Neon PostgreSQL with pgvector enabled) ====
# Use the pooled/non-pooled connection recommended by Neon for Prisma.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/neondb?sslmode=require
# Optional. Defaults to DATABASE_URL in scripts/start-local.ps1.
AI_DATABASE_URL=
# Required only when Docker Compose starts its bundled PostgreSQL service.
POSTGRES_USER=jcp
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=jcp_enterprise_ai

# ==== Backend (NestJS) ====
BACKEND_PORT=8000
JWT_SECRET=your-random-secret-min-32-chars
JWT_EXPIRES_IN=24h
AI_SERVICE_URL=http://127.0.0.1:8001
WORKER_TOKEN=your-worker-token-here

# Seed accounts (min 12 chars password)
SEED_ADMIN_EMAIL=admin@jcp.co.id
SEED_ADMIN_PASSWORD=admin1234567
SEED_USER_EMAIL=nadia@jcp.co.id
SEED_USER_PASSWORD=employee12345

# ==== AI Engine (Python/FastAPI) ====
SUMOPOD_API_KEY=sk-your-sumopod-api-key-here
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1

# ==== Frontend (React/Vite) ====
VITE_API_BASE_URL=http://127.0.0.1:8000
FRONTEND_PORT=5173
# VPS: ganti dengan URL HTTPS publik Backend. Nilai ini dibaca saat image
# production dibangun, jadi rebuild frontend setelah mengubahnya.
