# ==== Database (Docker PostgreSQL) ====
POSTGRES_USER=jcp
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=jcp_enterprise_ai
DATABASE_URL=postgresql://jcp:change-this-postgres-password@postgres:5432/jcp_enterprise_ai
AI_DATABASE_URL=postgresql://jcp:change-this-postgres-password@postgres:5432/jcp_enterprise_ai

# ==== Backend (NestJS) ====
BACKEND_PORT=8000
JWT_SECRET=your-random-secret-min-32-chars
JWT_EXPIRES_IN=24h
AI_SERVICE_URL=http://ai-api:8000
WORKER_TOKEN=your-worker-token-here

# Seed accounts (min 12 chars password)
SEED_ADMIN_EMAIL=admin@jcp.co.id
SEED_ADMIN_PASSWORD=admin1234567
SEED_USER_EMAIL=nadia@jcp.co.id
SEED_USER_PASSWORD=employee12345

# ==== AI Engine (Python/FastAPI) ====
SUMOPOD_API_KEY=sk-your-sumopod-api-key-here
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1

# ==== Frontend (React/Vite) ====
VITE_API_BASE_URL=http://localhost:8000
