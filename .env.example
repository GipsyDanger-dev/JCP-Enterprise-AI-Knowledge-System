# Copy this file to .env and fill in your values:
#   cp .env.example .env
# Real secrets must never be committed (`.env` is in .gitignore).

# SumoPod (OpenAI-compatible) — needed for --llm answers and embeddings.
SUMOPOD_API_KEY=sk-your-key-here

# AI response mode. Keep the provider key in the AI service only.
AI_USE_LLM=true
AI_CHAT_MODEL=deepseek-v4-pro
# `tfidf` is robust for the local JSON index. Switch to `vector` only after
# documents have been embedded with the configured embedding model.
AI_RETRIEVER=tfidf

# PostgreSQL + pgvector — needed for the shared Data Layer (store.py / http_api.py).
DATABASE_URL=postgresql://ai:aipassword@localhost:5432/ai
