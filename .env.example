# ==== Database (dipakai bersama oleh backend & ai-api) ====
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_DB=rag_knowledge
DATABASE_URL=postgresql://rag_user:rag_password@postgres:5432/rag_knowledge?schema=public

# ==== Backend (NestJS) ====
BACKEND_PORT=8000
LLM_API_KEY=
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
AI_SERVICE_URL=http://ai-api:8000
WORKER_TOKEN=replace-with-a-separate-long-random-worker-token

# Local development seed only. Replace these values before running the seed.
SEED_ADMIN_EMAIL=admin@local.test
SEED_ADMIN_PASSWORD=change-me-admin-password
SEED_USER_EMAIL=user@local.test
SEED_USER_PASSWORD=change-me-user-password

# ==== AI Service (Python/FastAPI) ====
SUMOPOD_API_KEY=

# ==== Frontend (React/Vite) ====
# PENTING: sebelumnya default frontend menunjuk ke :8080/api — sudah diperbaiki
# di sini supaya cocok dengan backend yang jalan tanpa prefix /api di :8000.
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_MOCK_AUTH=false
